# Ключ Anthropic для живой подсказки категории и перевода сообщений. Пусто: переводы недоступны, подсказки работают без сети.
ANTHROPIC_API_KEY=
# Модель Claude для подсказки. Пусто: claude-haiku-5-5.
AI_MODEL=
# ИИ-цепочка: Gemini -> второй провайдер -> правила без ИИ. Все ключи необязательны; без ключей сеть не используется.
GEMINI_API_KEY=
# Модель Gemini. Пусто: gemini-2.5-flash.
GEMINI_MODEL=
# Второй провайдер: ключ xAI (Grok) или Groq. AI_FALLBACK_PROVIDER=xai|groq выбирает явно; по умолчанию по тому, какой ключ задан.
XAI_API_KEY=
GROQ_API_KEY=
AI_FALLBACK_PROVIDER=
# Модель и адрес второго провайдера (необязательно). Пусто: grok-3-mini для xAI, llama-3.3-70b-versatile для Groq.
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
# Таймаут одного обращения к провайдеру, мс (500..30000). Пусто: 3000.
AI_TIMEOUT_MS=
# Ключ подписи токенов входа по паролю (любая длинная случайная строка). Пусто: случайный на процесс.
SESSION_SECRET=
